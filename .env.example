# ==============================================================================
# Variáveis de Ambiente - NFT Logistics
# Copie este arquivo para .env.local e preencha os valores antes de rodar em produção.
# ==============================================================================

# Segredo criptográfico para o sistema Anti-Bot (Obrigatório em produção)
# Gere uma chave segura executando no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_PROTECTION_SECRET=

# Configuração de E-mail SMTP (Nodemailer)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=contato@exemplo.com
SMTP_PASS=sua_senha_ou_app_password_aqui
SMTP_FROM=contato@exemplo.com

# Destinatário dos formulários de contato (E-mail que receberá as mensagens)
ADMIN_EMAIL=comercial@nftlogistics.com.br
