                >
                  <span>{t.hero.btnPrimary}</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ========================================================================= */}
      {/* 4. MISSÃO, VISÃO E VALORES (TRÍADE COM FOTOS REAIS)                       */}
